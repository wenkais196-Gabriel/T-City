# 测试环境变量示例
#
# 用法:
#   cp .env.example .env
#   # 填入真实值（.env 已被 .gitignore 忽略）
#   set -a; . ./.env; set +a
#   cd T-CityLite.base && python3 tests/run_all.py
#
# 注意: 不要把真实密码写进任何被 git 跟踪的文件。

TCITY_DB_HOST=localhost
TCITY_DB_PORT=3306
TCITY_DB_USER=your_user
TCITY_DB_PASS=your_password
TCITY_DB_NAME=TCityLite

# JS 测试用（没有单独字段时可直接给完整 URI）
TCITY_DB_URI=mysql://your_user:your_password@localhost:3306/TCityLite?charset=utf8mb4

# Agent 只读层 (#24): agent_ro 由 tools/setup_agent_ro.sh 创建。
# AGENT_DB_USER 默认 agent_ro；不要在这里填管理员账号。
AGENT_DB_PASS=your_agent_ro_password

# HTTP gateway bearer token（MCP sidecar 不需要）。留空时 gateway 拒绝启动。
# 生成: openssl rand -hex 32
AGENT_TOKEN=

# MCP 读通道（agent_gateway.py）
# AGENT_GATEWAY_URL=http://127.0.0.1:8787
# AGENT_GATEWAY_TOKEN=

# MCP 写通道（custom-director /agent/v1/act）。审计里的 X-Agent-Id 取 AGENT_AGENT_ID。
# AGENT_DIRECTOR_URL=http://127.0.0.1:30120/custom-director
# AGENT_DIRECTOR_TOKEN=
# AGENT_AGENT_ID=mcp.local

# 实时感知通道（/agent/v1/live/*）。必须与 director token 不同：
# 只读 agent 应当只拿到这个，拿不到写权限。未设置时不广告 live 工具。
# AGENT_LIVE_TOKEN=

# 实机冒烟（tools/agent_smoke.py；全部可选，缺失则跳过对应检查）
# AGENT_ADMIN_TOKEN=        # approve 检查；对应 agent_actions_admin_token
# AGENT_SMOKE_CITIZENID=    # 真实写测试目标玩家（必须在线）
