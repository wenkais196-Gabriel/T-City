{
  "$comment": "资源内部的鉴权 helper 登记表。只有**证明过一次**的 helper 才能让调用点算作已鉴权：defined_at 里必须恰好定义一次、函数体含 requires 里的全部证据，且资源内每一处调用都必须是 `if not H(...) then return` 形状（调用但不看返回值不算）。新增 helper 请连同 test_net_event_auth.py::test_registered_guard_helpers_are_proven 一起过。",
  "custom-vehicles": {
    "CanModifyPlate": {
      "defined_at": "custom-vehicles/server/vehicle_state.lua",
      "requires_code": [
        "QBCore.Functions.GetPlayer(src)",
        "PlayerData.citizenid",
        "KeyManager.GetOwner(plate)",
        "return false"
      ],
      "requires_raw": [
        "job.name == 'mechanic'",
        "onduty"
      ],
      "why": "车牌写权限 = 车主 citizenid 相等，或执勤机修；其余一律 false"
    },
    "IsEmergencyService": {
      "defined_at": "custom-vehicles/server/dashboard_api.lua",
      "requires_code": [
        "QBCore.Functions.GetPlayer(src)",
        "return false"
      ],
      "requires_raw": [
        "job.name == 'police'",
        "job.name == 'ambulance'",
        "job.name == 'fire'"
      ],
      "why": "紧急服务职业判定：PA 喊话 / 警笛 / 测速雷达 / 锚定只对这些职业开放"
    },
    "IsSeatedIn": {
      "defined_at": "custom-vehicles/server/vehicle_state.lua",
      "requires_code": [
        "GetPlayerPed(src)",
        "GetVehiclePedIsIn(ped, false) == veh",
        "return false"
      ],
      "requires_raw": [],
      "why": "广播类事件（氮气火焰）只允许车里的人触发"
    },
    "IsSeatedInPlate": {
      "defined_at": "custom-vehicles/server/main.lua",
      "requires_code": [
        "NormalizePlate(plate)",
        "GetVehiclePedIsIn(ped, false)",
        "NormalizePlate(GetVehicleNumberPlateText(veh)) == want",
        "return false"
      ],
      "requires_raw": [],
      "why": "中控屏锁只对坐在该车牌车内的人开放"
    },
    "CanClaimPlate": {
      "defined_at": "custom-vehicles/server/compat.lua",
      "requires_code": [
        "KeyManager.GetOwner(plate)",
        "MySQL.scalar.await(",
        "IsNearVehicleWithPlate(src, plate)",
        "return false"
      ],
      "requires_raw": [
        "FROM player_vehicles WHERE plate = ?"
      ],
      "shape": "local_check",
      "why": "车牌认领：会话车主 / 数据库车主一致，无主车必须在车旁（GiveKeys 与 AcquireVehicleKeys 共用）"
    },
    "HasActiveQuest": {
      "defined_at": "custom-vehicles/server/dashboard_api.lua",
      "requires_code": [
        "GetActiveQuests(src)",
        "pcall(",
        "return ok and type(quests) ==",
        "#quests > 0"
      ],
      "requires_raw": [],
      "why": "有进行中的任务才允许快捷装货（custom-quest 未就绪时按没有任务处理）"
    },
    "HoldsDashboardLock": {
      "defined_at": "custom-vehicles/server/main.lua",
      "requires_code": [
        "QBCore.Functions.GetPlayer(src)",
        "NormalizePlate(plate)",
        "dashboardLocks[want] ==",
        "return false"
      ],
      "requires_raw": [],
      "why": "中控屏排他锁：只有锁的持有者（按归一化车牌）能切驾驶模式/操作中控台"
    },
    "FindLogisticsQuest": {
      "defined_at": "custom-vehicles/server/dashboard_api.lua",
      "requires_code": [
        "GetActiveQuests(src)",
        "LOGISTICS_QUESTS[quest.quest_id]",
        "return nil"
      ],
      "requires_raw": [],
      "shape": "local_check",
      "why": "只认具体物流任务模板（euro_trucking_steel / heavy_trailer / aviation_smuggling_flight）"
    }
  },
  "custom-police": {
    "onDutyOfficer": {
      "defined_at": "custom-police/server/evidence.lua",
      "requires_code": [
